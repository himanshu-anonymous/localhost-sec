# ==============================================================================
# AEGIS — Configuration and Environment Specification
# Copy to .env for local runtime execution
# ==============================================================================

# Core Orchestration
PROJECT_NAME="AEGIS"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="aegis-dev-super-secret-key-change-in-prod"

# Local Host Port Bindings (All bind strictly to 127.0.0.1)
FRONTEND_PORT=3000
BACKEND_PORT=8000
GATEWAY_PORT=8443
GATEWAY_ADMIN_PORT=8088
POLICY_AGENT_PORT=8090
POSTGRES_PORT=5432
REDIS_PORT=6379

# Docker Lab Network Subnets (Must not overlap host LAN)
SUBNET_FRONTEND="172.31.1.0/24"
SUBNET_CONTROL="172.31.2.0/24"
SUBNET_OBSERVABILITY="172.31.3.0/24"
SUBNET_ACCESS="172.31.10.0/24"
SUBNET_TARGET="172.31.20.0/24"

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=aegis_secure_local_dev_password_2026
POSTGRES_DB=aegis_db
POSTGRES_HOST=postgres
DATABASE_URL="postgresql+psycopg2://aegis_admin:aegis_secure_local_dev_password_2026@postgres:5432/aegis_db"

# Redis Event Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Gateway & Policy Agent
POLICY_AGENT_TOKEN="aegis-secret-policy-token-2026"
LAB_ACCESS_SUBNET="172.31.10.0/24"
HAPROXY_SOCKET_PATH="/var/run/haproxy.sock"
ACL_FILE_PATH="/etc/haproxy/acl/blocked_ips.lst"

# Gemma AI Configuration (Sole LLM Integration)
GEMMA_PROVIDER="google_cloud"
GEMMA_MODEL="gemma-4-it"
GEMMA_TIMEOUT_SECONDS=10
GEMMA_MAX_OUTPUT_TOKENS=1024
# Set your Gemma API key (or parallel environment keys)
GEMMA_API_KEY=""
LOCALHOST_KEY1=""
LOCALHOST_KEY2=""
LOCALHOST_KEY3=""
LOCALHOST_KEY4=""
