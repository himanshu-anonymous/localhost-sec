# localhost Environment Configuration Template
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to version control!

# Dedicated Gemma Reasoning Service Keys (Domain C)
LOCALHOST_KEY1=your_key_1_here
LOCALHOST_KEY2=your_key_2_here
LOCALHOST_KEY3=your_key_3_here
LOCALHOST_KEY4=your_key_4_here
GEMMA_API_KEY=your_key_1_here

# PostgreSQL 16 (Persistent Relational Store)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=localhost_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Neo4j 5 (Ephemeral Runtime Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Redis 7 (Telemetry & Event Broker)
REDIS_HOST=localhost
REDIS_PORT=6380
